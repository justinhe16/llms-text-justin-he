# Prisma environment configuration. Copy to `db/.env` for local development, or generate
# it directly:
#
#     ./scripts/local-env.sh write-db-env
#
# THIS FILE IS COMMITTED AND CARRIES A PLACEHOLDER ONLY. Never put a real key, token, or
# credentialed connection string in it: this repository is public and its history is
# permanent. `.env` is gitignored and stays that way. See ARCHITECTURE.md section 9.
#
# In CI, this does not come from a file — DIRECT_DATABASE_URL is a GitHub Actions secret,
# read by the `prisma migrate deploy` job before the application deploy (README.md
# "Deploy Policy").


# --- Database (REQUIRED) ------------------------------------------------------

# Direct (non-pooled) Postgres connection string. Prisma needs a direct connection to run
# migrations; it is never used at runtime by the application (asyncpg is, via
# DATABASE_URL — see backend/.env.example).
# Local: written by `./scripts/local-env.sh write-db-env` from `supabase status -o env`.
# Deployed: Supabase Dashboard -> Project Settings -> Database -> Connection string,
# stored as a GitHub Actions secret, never a Fly secret (Prisma does not run on Fly).
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
