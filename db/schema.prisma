// Prisma is a schema and migration tool in this project, and nothing else. There is
// deliberately no `generator client` block here, and `@prisma/client` is not a dependency
// of this package: the backend reads and writes with asyncpg, using hand-written SQL in
// each feature's reader and writer, and the frontend never touches the database at all.
// See ARCHITECTURE.md §6.1 ("Prisma Client is not a runtime dependency").
//
// How to change the schema — ARCHITECTURE.md §6.2:
//   1. Edit this file.
//   2. `npm run migrate:dev` (prisma migrate dev --create-only) — generates the migration
//      SQL without applying it.
//   3. Read the generated SQL in db/migrations/. Check for destructive operations, missing
//      indexes, and locks a large table would take.
//   4. Commit the migration directory together with this file, in the same PR.
//   5. CI applies it with `prisma migrate deploy` (`npm run migrate:deploy`), before the
//      application deploy.

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------------------
// Conventions used below — ARCHITECTURE.md §10.4:
//
//   * Tables are plural snake_case, so every model carries `@@map`. Columns are
//     snake_case, so every camelCase field carries `@map`. The physical name is the one
//     that matters here: readers and writers address these columns in hand-written SQL,
//     never through a generated client.
//   * Every primary key defaults to `gen_random_uuid()` via `dbgenerated`, not Prisma's
//     `@default(uuid())`. `@default(uuid())` generates the value in Prisma Client, which
//     this project does not run — it would emit a column with no database default and
//     every asyncpg INSERT would have to supply an id.  `gen_random_uuid()` is core
//     Postgres from 13 onward, so no extension is required.
//   * Every timestamp is `timestamptz`. This system's whole purpose is scheduling;
//     a naive timestamp is a bug waiting for the next DST transition.
//     `@default(now())` renders as `DEFAULT CURRENT_TIMESTAMP`, which is Postgres's
//     spelling of `now()` — the same function, evaluated at transaction start.
//
// On the absence of a foreign key to `auth.users` — see `Website.userId` below.
// ---------------------------------------------------------------------------------------

/// A site a user has added, identified for dedupe purposes by its normalized origin.
model Website {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The owner, holding an `auth.users(id)` value from Supabase Auth.
  ///
  /// There is deliberately NO foreign key to `auth.users` here, and none is added by
  /// hand in the migration either. Two reasons, in order of weight:
  ///
  ///   1. `auth` is Supabase's schema, not ours. Prisma cannot model it without
  ///      `multiSchema`, and pointing Prisma at `auth` invites it to generate DROPs for
  ///      objects Supabase owns. The ticket that created this table calls that out.
  ///   2. The migration has to apply, unchanged, to every database the project targets.
  ///      CI's test database is a bare `postgres:16` service container with no `auth`
  ///      schema at all (.github/workflows/ci-backend.yml), and it is migrated with the
  ///      same `prisma migrate deploy` production runs. A constraint that only exists in
  ///      one of those environments is a migration that fails in the other.
  ///
  /// Consequence, stated plainly rather than discovered later: Supabase Auth is the
  /// system of record for users, and Postgres will not stop a row here from referencing
  /// a deleted user. Deleting a user does not cascade to their websites. Nothing in this
  /// milestone deletes users; when something does, it owns the cleanup.
  userId String @map("user_id") @db.Uuid

  /// The URL exactly as the user submitted it — kept for display and for debugging what
  /// normalization did.
  url String

  /// Normalized scheme + host (e.g. `https://example.com`). The dedupe key.
  origin String

  /// Populated by a crawl; null until one has run.
  title String?

  /// Whether this website's runs ask for model-assisted summarization — a written title and
  /// description per page in place of what `internals/extract.py` pulled out of the page's
  /// own markup. This is only ever HALF of the gate: a run enriches when this column AND
  /// the deployment-wide `Settings.crawl_enrich_with_llm` are both true
  /// (`CrawlService.execute_run`, PER-194). `false` by default, so an existing website's
  /// behaviour is byte-identical to what it was before this column existed — nobody's runs
  /// change shape because a migration ran. This records the OWNER'S INTENT, never the
  /// deployment's current capability (no API key, the flag off, a transient API error all
  /// look identical from here — see `runs.stats["enrich_unavailable_reason"]` for how a run
  /// reports which one it hit). Settable by the owner at any time via `PATCH
  /// /websites/{id}`; a change applies to the NEXT run only; ARCHITECTURE.md §4.2's
  /// `require_owner` gate applies to writing it exactly as it does to every other write in
  /// this schema.
  enrichWithLlm Boolean @default(false) @map("enrich_with_llm")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedule Schedule?
  runs     Run[]

  /// One user cannot add the same site twice; two users each adding it is fine. This
  /// project is not multi-tenant (ARCHITECTURE.md §4) — the pair is a dedupe key, not a
  /// tenancy boundary.
  @@unique([userId, origin])
  @@index([userId])
  @@map("websites")
}

/// The recurring-run configuration for a website. At most one per website.
model Schedule {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Unique, which is what makes this a one-to-one: a website has at most one schedule.
  websiteId String  @unique @map("website_id") @db.Uuid
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  active Boolean @default(false)

  /// Minutes between runs, not a cron expression. The UI presets (hourly / 6-hourly /
  /// daily / weekly) map to 60 / 360 / 1440 / 10080. See ARCHITECTURE.md §6.4 for why.
  intervalMinutes Int @map("interval_minutes")

  /// Null while the schedule is inactive. The cron tick reads `(active, next_run_at)`.
  nextRunAt DateTime? @map("next_run_at") @db.Timestamptz(6)
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(6)

  /// RESERVED, UNUSED IN THIS MILESTONE. No code reads or writes this column yet; it is
  /// here so that turning on publish-on-success later is a behaviour change rather than
  /// a migration on a table the cron tick is actively scanning. Do not build against it.
  autoPublish Boolean @default(false) @map("auto_publish")

  runs Run[]

  /// The cron tick's hot path: "which active schedules are due?".
  @@index([active, nextRunAt])
  @@map("schedules")
}

/// One generation attempt for a website — manual or scheduled — and its result.
model Run {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  websiteId String  @map("website_id") @db.Uuid
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// Null for a manual run, and nulled out if the schedule that started this run is
  /// later deleted — run history outlives the schedule that produced it.
  scheduleId String?   @map("schedule_id") @db.Uuid
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  trigger RunTrigger
  status  RunStatus  @default(pending)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// How many times a worker has CLAIMED this run, incremented by `RunsWriter.claim_pending`
  /// inside the same atomic `pending -> processing` UPDATE. It counts attempts that actually
  /// STARTED, not jobs that were queued — an enqueue that never reached a worker leaves this
  /// at its previous value, which is exactly what makes it a retry budget rather than a
  /// queue-depth statistic. The stuck-run reaper's requeue-or-fail decision reads it, and so
  /// does the terminal error message ("Failed after 3 attempts: …").
  ///
  /// Deliberately NOT arq's `ctx["job_try"]`. That counter is per arq job id, resets whenever
  /// a job is re-enqueued under a new id, and is invisible to the reaper — which runs in a
  /// different process from the job it is rescuing and has only the database to go on.
  attempts Int @default(0)

  /// When the run's current `processing` attempt was claimed — written by `claim_pending`
  /// alongside `attempts`, cleared when the reaper hands a run back to `pending`.
  ///
  /// THE REAPER'S STALENESS CLOCK, and the reason it is not `started_at`. `started_at` is set
  /// at INSERT, which is when the run was ENQUEUED, not when a worker picked it up. Those two
  /// instants are the same only when the queue is empty: `max_jobs = 2` against a batch of up
  /// to `DUE_BATCH_LIMIT` scheduled runs can leave a run legitimately `pending` for an hour,
  /// and a reaper measuring from `started_at` would then reap it moments after a worker
  /// finally claimed it — duplicating a crawl that was progressing fine, which is the one
  /// outcome the reaper's threshold exists to avoid.
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)

  /// The generated index — the `llms.txt` artifact. Null until the run completes.
  llmsTxt String? @map("llms_txt")

  /// The generated expansion — the `llms-full.txt` artifact, every indexed page's markdown
  /// inlined. Null until the run completes, and null forever on rows written before PER-179
  /// added the column. Nullable and additive precisely so the release running at migration
  /// time survives it, which is what keeps the migrate-then-deploy window safe
  /// (ARCHITECTURE.md §6.3).
  ///
  /// Bounded independently of the crawl's own byte cap — 50 KB per page and 5 MB per run, in
  /// `internals/llms_txt.py` — because `crawl_max_bytes` limits what comes off the WIRE and
  /// says nothing about how large the extracted text inlined here will be.
  llmsFullTxt String? @map("llms_full_txt")

  /// `pages_crawled`, `pages_failed`, `bytes_fetched`, `duration_ms`, `cap_hit`,
  /// `pages_empty_content`, `links_emitted`, `full_txt_truncated`, `discovery_source`,
  /// `urls_discovered`, `urls_selected`, `urls_robots_disallowed`, `crawl_delay_ms`,
  /// `pages_enriched`, `enrich_failures`, `enrich_input_tokens`, `enrich_output_tokens`,
  /// `llms_txt_bytes`, `index_diff`, `enrich_requested`, `enrich_applied`,
  /// `enrich_unavailable_reason`, `content_hashes`, and `version` — the shape
  /// `internals/run_stats.py` builds and owns, at `RUN_STATS_VERSION` 8. Jsonb rather than
  /// columns because the set of keys has changed eight times already and belongs to the
  /// crawler feature rather than to this schema; `version` is what lets a reader tell which
  /// definition a stored row was written under (ARCHITECTURE.md §3.4). `urls_robots_disallowed`
  /// (int) and `crawl_delay_ms` (int) are PER-191's additions: how many candidates this run's
  /// `robots.txt` disallowed, and the politeness delay the crawl phase actually used.
  /// `llms_txt_bytes` (int) and `index_diff` (object | null) are PER-193's additions: the
  /// generated index's size, and what changed against the previous completed run's index —
  /// see `internals/index_diff.py`'s `build_index_diff` for the two shapes `index_diff` can
  /// take. **PER-194's additions**: `enrich_requested` (bool) — this run's website had
  /// `enrich_with_llm` set at the time it ran; `enrich_applied` (bool) — at least one page
  /// actually got a model-written title/description; `enrich_unavailable_reason` (one of
  /// `"deployment_disabled"`, `"no_api_key"`, `"api_error"`, or JSON `null`) — why enrichment
  /// was requested but not applied, `null` both when it applied and when it was never
  /// requested (see `run_stats.py`'s version-8 paragraph for why those two cannot be told
  /// apart from this key alone — `enrich_requested` is what disambiguates them);
  /// `content_hashes` (object, worker-only — stripped from every API response by
  /// `runs/service.py`'s `_public_stats`) — a `{normalized_url: content_hash}` map of this
  /// run's page bodies, the side-channel `internals/index_diff.py` joins against the
  /// previous run's own map to compute `index_diff.content_changed` independently of a mode
  /// flip. PER-194 also renames `index_diff`'s inner `pages_changed`/`changed_sample` to
  /// `metadata_changed`/`metadata_changed_sample` and adds `content_changed`,
  /// `content_changed_sample`, and `metadata_not_comparable_reason` — doc-comment-only here,
  /// since `index_diff` is itself schemaless jsonb; see `internals/index_diff.py`'s
  /// `build_index_diff` for the full shape. This is a doc-comment update only; the column
  /// type is unchanged (CLAUDE.md #2), so it needs no migration.
  stats Json? @db.JsonB

  /// Set when `status` is `failed`.
  error String?

  /// Where the raw `.jsonl` payload landed in Supabase Storage.
  storagePath String? @map("storage_path")

  // THERE IS A SEVENTH INDEX ON THIS TABLE THAT IS NOT DECLARED HERE:
  //
  //     CREATE INDEX "runs_status_active_idx" ON "runs"("status")
  //         WHERE "status" IN ('pending', 'processing');
  //
  // It lives only in db/migrations/20260805092204_init/migration.sql, hand-written,
  // because Prisma has no syntax for a partial index. Do not "fix" that by adding an
  // `@@index([status])` line here — that was tried, and it is actively wrong:
  // Prisma's introspection cannot see a partial index at all, so it reads the database
  // as not having one and every subsequent `make migrate` would emit another
  // `CREATE INDEX "runs_status_active_idx"`, which fails against a database that
  // already has it. Verified with `prisma migrate diff` against the applied schema:
  // declared, the diff is a spurious CREATE; undeclared, the diff is empty.
  //
  // The trade-off accepted here is that this one index is invisible to Prisma. It is
  // therefore also invisible to Prisma's drift detection, and the comment above is the
  // only thing keeping it from being forgotten.
  //
  // It is partial because both of its scanners — the duplicate-run guard on a manual
  // trigger and the stuck-run reaper — look for exactly these two statuses, while the
  // rows that accumulate forever are the completed and failed ones.

  /// History queries and the latest-run lookup, which both read newest-first.
  @@index([websiteId, startedAt(sort: Desc)])
  @@map("runs")
}

// Real Postgres enums, not text with a CHECK: the worker writes status transitions
// directly, and a typo should fail loudly at the database rather than persist a value no
// reader knows how to interpret.
//
// Adding a value to either of these later means `ALTER TYPE ... ADD VALUE`, which Prisma
// generates but which has two constraints worth knowing before you need it: on Postgres
// below 12 it cannot run inside a transaction block at all (and Prisma wraps a migration
// in one), and on 12 and above the new value can be added transactionally but not *used*
// until that transaction commits. Give such a change its own migration, and expect to
// mark it `-- prisma-migrate: no-transaction` or split it in two. Both the local stack
// and CI run Postgres 16+, so this is a note for the future, not a problem today.

/// What started a run.
enum RunTrigger {
  manual
  scheduled

  @@map("run_trigger")
}

/// Where a run is in its lifecycle. `pending` and `processing` are the in-flight pair the
/// partial index on `runs.status` covers.
enum RunStatus {
  pending
  processing
  completed
  failed

  @@map("run_status")
}
