{
  "name": "llms-text-db",
  "private": true,
  "description": "Prisma schema and migration tooling for llms-text. Schema authoring and migrations only — see schema.prisma and ARCHITECTURE.md §6.",
  "scripts": {
    "migrate:dev": "prisma migrate dev --create-only --schema=schema.prisma",
    "migrate:apply": "prisma migrate dev --schema=schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=schema.prisma",
    "migrate:status": "prisma migrate status --schema=schema.prisma"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
