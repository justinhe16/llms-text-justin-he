# Backend environment configuration. Copy to `backend/.env` for local development:
#
#     cp backend/.env.example backend/.env
#
# THIS FILE IS COMMITTED AND CARRIES PLACEHOLDERS ONLY. Never put a real key, token, or
# credentialed connection string in it: this repository is public and its history is
# permanent. `.env` is gitignored and stays that way. See ARCHITECTURE.md section 9.
#
# In deployed environments none of this comes from a file — the values are supplied by
# `fly secrets set` on the Fly app, and by nothing else.
#
# Both processes that run from the backend image read this same configuration: the
# FastAPI API (web) and the ARQ worker. The queue variables are listed here now, even
# though the worker itself lands in a later ticket, so one file describes the whole
# service.
#
# The variables marked REQUIRED are checked at startup. If any is missing, the process
# refuses to boot and names every missing variable at once.


# --- Application -------------------------------------------------------------

# development | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# --- Database (REQUIRED; read by the API and the worker) ---------------------

# Postgres connection string. The backend reaches Postgres over asyncpg; Prisma is used
# for schema and migrations only and never connects at runtime.
# Where to get it: Supabase Dashboard -> Project Settings -> Database -> Connection
# string. Use the Session pooler URI, which is IPv4-reachable from Fly.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres


# --- Redis / ARQ queue (REQUIRED; read by the API and the worker) ------------

# Redis instance backing the ARQ job queue. Both processes need it: the API enqueues
# crawl runs and the worker consumes them.
# Local: `docker run --rm -p 6379:6379 redis:7-alpine`, then use the value below.
# Deployed: provisioned by the infrastructure ticket; set with `fly secrets set`.
REDIS_URL=redis://localhost:6379/0


# --- Supabase (REQUIRED; Auth and Storage over HTTPS) ------------------------

# Project URL.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Server-side secret (service-role) key, used to verify sessions and to write to
# Storage. It bypasses row-level security, so it is a backend-only credential: it must
# never appear anywhere under frontend/, and never behind a NEXT_PUBLIC_ prefix.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project API keys.
SUPABASE_SECRET_KEY=<your-supabase-secret-key>


# --- Observability (optional) ------------------------------------------------

# Sentry DSN. Leave empty to disable error reporting, which is the norm locally.
# Where to get it: Sentry -> Project -> Settings -> Client Keys (DSN).
SENTRY_DSN=
