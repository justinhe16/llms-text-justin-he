# Backend environment configuration. Copy to `backend/.env` for local development:
#
#     cp backend/.env.example backend/.env
#
# THIS FILE IS COMMITTED AND CARRIES PLACEHOLDERS ONLY. Never put a real key, token, or
# credentialed connection string in it: this repository is public and its history is
# permanent. `.env` is gitignored and stays that way. See ARCHITECTURE.md section 9.
#
# In deployed environments none of this comes from a file — the values are supplied by
# `fly secrets set` on the Fly app, and by nothing else.
#
# Both processes that run from the backend image read this same configuration: the FastAPI
# API (the `app` process) and the ARQ worker (the `worker` process). See backend/fly.toml
# for how one image becomes two.
#
# The variables marked REQUIRED are checked at startup. If any is missing, the process
# refuses to boot and names every missing variable at once.


# --- Application -------------------------------------------------------------

# development | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Abuse protection for POST /websites/{id}/runs (optional; the defaults below are the
# ticket's own numbers and rarely need overriding). Both are per-user, read by the API
# only: the concurrency cap counts only your own in-flight *manual* runs, and the daily
# cap counts every run you trigger or that runs on your behalf on a schedule, over a
# rolling 24 hours. See app/core/settings.py for the full reasoning.
MAX_CONCURRENT_RUNS_PER_USER=2
MAX_RUNS_PER_DAY_PER_USER=50


# --- Database (REQUIRED; read by the API and the worker) ---------------------

# Postgres connection string. The backend reaches Postgres over asyncpg; Prisma is used
# for schema and migrations only and never connects at runtime.
# Where to get it: Supabase Dashboard -> Project Settings -> Database -> Connection
# string. Use the Session pooler URI, which is IPv4-reachable from Fly.
#
# Must be the Session pooler on port 5432, not the transaction pooler on 6543: the
# transaction pooler multiplexes clients onto shared connections per transaction, which
# breaks asyncpg's prepared-statement cache. See app/infrastructure/db/pool.py for the
# full explanation and the guard that detects a 6543 URL at startup.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# Connection pool sizing (optional; the defaults below are sane for a single small Fly
# machine and rarely need overriding). Kept small because Supabase connection limits are
# real and the API and the ARQ worker share the same budget.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30.0


# --- Redis / ARQ queue (REQUIRED; read by the API and the worker) ------------

# Redis instance backing the ARQ job queue. Both processes need it: the API enqueues
# crawl runs and the worker consumes them.
#
# THE SCHEME IS LOAD-BEARING. `rediss://` turns TLS on and `redis://` leaves it off, and
# nothing in the code hardcodes either — see app/infrastructure/queue/pool.py. Production
# is Upstash and must be `rediss://`; a `redis://` Upstash URL would put this password on
# the public internet in cleartext.
#
# Local: `docker compose up -d redis` (or just `make dev`), then use the value below.
# Deployed: Upstash, set with `fly secrets set` — see README.md "Where each credential
# lives" for the one-liner that pipes it across without it landing in your shell history.
REDIS_URL=redis://localhost:6379/0


# --- Supabase (REQUIRED; Auth and Storage over HTTPS) ------------------------

# Project URL.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Server-side secret (service-role) key, used to verify sessions and to write to
# Storage. It bypasses row-level security, so it is a backend-only credential: it must
# never appear anywhere under frontend/, and never behind a NEXT_PUBLIC_ prefix.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project API keys.
SUPABASE_SECRET_KEY=<your-supabase-secret-key>


# --- Crawl (optional; read by the worker's crawl task) -----------------------

# Hard caps on one crawl run. Hitting one of these is a SUCCESS, not a failure: the crawl
# returns whatever pages it collected before the cap tripped. Enforced by the crawl loop
# (app/features/crawl/internals/crawler.py, a later phase of this feature); this phase only
# declares the settings themselves.
CRAWL_MAX_PAGES=100

# Wall-clock budget for one run, in seconds, and the cap that actually ends a long crawl.
# job_timeout (app/worker/policy.py) sits at 600s — twice this — so the crawl's own budget
# lands first and the run records a clean failure saying so. PER-166 corrected that
# ordering; it used to be the other way round, with a 180s job_timeout cancelling crawls
# before this value ever bound. Raising this above 600s would restore the inversion, so if
# it ever needs to grow, job_timeout grows with it.
CRAWL_MAX_WALL_CLOCK_S=300.0

# Total response bytes across every page in one run. Default is 50 MiB (52428800 bytes).
CRAWL_MAX_BYTES=52428800

# Per-request timeout, in seconds, for one page fetch.
CRAWL_REQUEST_TIMEOUT_S=10.0

# Maximum number of pages fetched concurrently within one run.
CRAWL_CONCURRENCY=5

# Minimum gap, in milliseconds, between the start of one request and the next, across the
# whole run — a politeness delay against the site being crawled.
CRAWL_POLITENESS_DELAY_MS=200

# Sitemap discovery caps (app/features/crawl/internals/sitemap.py), which runs before the
# crawl loop above and fills its frontier. Hitting either is a success, not a failure — see
# app/core/settings.py for the full reasoning.
#
# Counts every sitemap-document fetch ATTEMPT (both well-known probes, every robots.txt
# `Sitemap:` target, every index child) regardless of outcome; robots.txt itself does not
# count. Five leaves three documents for a site that falls through to robots.txt.
CRAWL_SITEMAP_MAX_DOCUMENTS=5

# A defensive cap on accumulated discovered URLs, not a tuning knob — the byte share below
# usually binds first. Exists so a pathological document cannot grow unbounded in memory.
CRAWL_SITEMAP_MAX_URLS=50000


# --- Supabase Storage (optional; read by the worker) -------------------------

# The bucket a completed run's gzip-compressed JSONL payload is uploaded to. Local: declared
# in supabase/config.toml ([storage.buckets.crawl-payloads]) and provisioned automatically by
# `make dev`. Production: created by hand in the Supabase dashboard — nothing in CI or the
# deploy pipeline creates it. See README.md "Infrastructure" for the manual bootstrap step.
SUPABASE_STORAGE_BUCKET=crawl-payloads

# Timeout, in seconds, for one upload to Storage. Deliberately below WorkerSettings.
# JOB_TIMEOUT_SECONDS (180s, app/worker/settings.py) — see app/core/settings.py for why that
# ordering matters — and larger than CRAWL_REQUEST_TIMEOUT_S above, since an upload moves a
# compressed multi-megabyte payload rather than one page.
STORAGE_UPLOAD_TIMEOUT_S=120.0


# --- Observability -----------------------------------------------------------
#
# There is nothing to set here, and that is deliberate. Both processes write one JSON
# object per line to stdout (app/core/logging.py): every API line carries a request id,
# every worker line carries the run_id of the crawl that produced it, and
#
#     fly logs --app llms-text-justin-he | jq 'select(.run_id == "...")'
#
# is how one run is reconstructed out of a stream interleaved with every other job.
# LOG_LEVEL, at the top of this file, is the only knob — set it to DEBUG locally for
# per-fetch detail without shipping that volume in production.
#
# There is NO error-tracking service on either side of this system, by design. An earlier
# revision of this file carried a SENTRY_DSN placeholder for an integration that is not
# happening; it is gone rather than sitting here unread. Adding one back is its own
# ticket, not a line somebody restores. See ARCHITECTURE.md section 3.8.
