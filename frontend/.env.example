# Frontend environment configuration. Copy to `frontend/.env.local` for local
# development:
#
#     cp frontend/.env.example frontend/.env.local
#
# THIS FILE IS COMMITTED AND CARRIES PLACEHOLDERS ONLY. Never put a real key,
# token, or credentialed connection string in it: this repository is public and
# its history is permanent. `.env.local` is gitignored and stays that way. See
# ARCHITECTURE.md section 9.
#
# In deployed environments none of this comes from a file — the values are
# supplied by Vercel project environment variables, and by nothing else.


# --- Supabase (browser-visible) ----------------------------------------------

# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle served to
# the browser, and is public forever. Only values that are safe to publish
# belong behind this prefix.

# Project URL.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Publishable (anon) key. Safe to expose to the browser: it carries no
# privileges of its own and is designed to be shipped to clients.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project API keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>

# The Supabase secret (service-role) key is a BACKEND credential. It bypasses
# row-level security, and it must never appear in this file, anywhere else
# under frontend/, or behind any prefix. It belongs to the Fly app only.
# See ARCHITECTURE.md section 8.3.

# For local development, `make dev` generates frontend/.env.local from the running
# local Supabase stack (`scripts/local-env.sh write-frontend-env`) — you do not need to
# fill in the values above by hand. It will not overwrite a frontend/.env.local you have
# already edited.


# --- API (server-only) -------------------------------------------------------

# Base URL of the FastAPI service on Fly.
#
# SERVER-ONLY: this must NEVER be prefixed NEXT_PUBLIC_. The browser does not
# call Fly. Requests go to the Next.js route handlers under `app/api/[...path]/`,
# which forward to FastAPI server-side — which is also why there is no CORS
# configuration anywhere in this repo. See ARCHITECTURE.md sections 8.1 and 8.3.
#
# Local: point this at the API from `backend/`, e.g. http://localhost:8000
API_URL=https://<your-fly-app>.fly.dev
